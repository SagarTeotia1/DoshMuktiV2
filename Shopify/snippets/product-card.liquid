{%- comment -%}
  Product card — image sits in a mehrab (temple-arch) niche; discount is a kumkum seal.
  Params: product (required), list_name (optional)
  A tag of the form "badge:Bestseller" shows as a small ink tag on the photo.
{%- endcomment -%}
{%- liquid
  assign badge = ''
  for tag in product.tags
    if tag contains 'badge:'
      assign badge = tag | remove: 'badge:' | strip
    endif
  endfor

  assign discount = 0
  if product.compare_at_price > product.price
    assign discount = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
  endif

  assign quick_variant = product.variants | where: 'available', true | first

  assign low_stock = 0
  if quick_variant and quick_variant.inventory_management == 'shopify' and quick_variant.inventory_policy == 'deny'
    if quick_variant.inventory_quantity > 0 and quick_variant.inventory_quantity <= 5
      assign low_stock = quick_variant.inventory_quantity
    endif
  endif
-%}
<a href="{{ product.url }}" class="product-card" data-product-id="{{ product.id }}" data-list="{{ list_name | escape }}">
  <div class="product-card__media">
    {%- if product.featured_image -%}
      {%- assign second = product.images[1] -%}
      {{
        product.featured_image
        | image_url: width: 600
        | image_tag:
          loading: 'lazy',
          widths: '240, 360, 480, 600',
          sizes: '(max-width: 640px) 44vw, (max-width: 1024px) 33vw, 25vw',
          alt: product.featured_image.alt,
          class: 'product-card__img'
      }}
      {%- if second -%}
        {{
          second
          | image_url: width: 600
          | image_tag:
            loading: 'lazy',
            widths: '240, 360, 480, 600',
            sizes: '(max-width: 640px) 44vw, (max-width: 1024px) 33vw, 25vw',
            alt: product.title,
            class: 'product-card__img product-card__img--hover'
        }}
      {%- endif -%}
    {%- else -%}
      <div class="product-card__noimg"><span>{{ 'products.product.no_image' | t }}</span></div>
    {%- endif -%}

    {%- if discount > 0 and product.available -%}
      <span class="seal" aria-label="{{ discount }}% off">{{ discount }}%<small>off</small></span>
    {%- endif -%}

    {%- if low_stock > 0 -%}
      <span class="low-stock">Only {{ low_stock }} left</span>
    {%- elsif badge != blank -%}
      <span class="badge-tag">{{ badge }}</span>
    {%- endif -%}

    {%- unless product.available -%}
      <div class="product-card__soldout"><span>{{ 'products.product.sold_out' | t }}</span></div>
    {%- endunless -%}

    {%- if quick_variant -%}
      <div class="product-card__actions">
        <button type="button" class="icon-btn icon-btn--bronze" data-quick-add data-variant-id="{{ quick_variant.id }}" aria-label="{{ 'products.product.add_to_cart' | t }}">
          {% render 'icon', icon: 'shopping-bag', size: 18 %}
        </button>
      </div>
    {%- endif -%}
  </div>

  <div class="product-card__body">
    <h3 class="product-card__title">{{ product.title }}</h3>
    <div class="product-card__price">
      <span class="price">{% render 'price', amount: product.price %}</span>
      {%- if product.compare_at_price > product.price -%}
        <s class="price price--compare">{% render 'price', amount: product.compare_at_price %}</s>
      {%- endif -%}
    </div>
  </div>
</a>
