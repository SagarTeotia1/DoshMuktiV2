<section class="purpose-grid">
  <div class="container">
    <div class="purpose-grid__head" data-reveal>
      <h2 class="section-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.subtitle != blank -%}<span class="section-head__hi" lang="hi">{{ section.settings.subtitle }}</span>{%- endif -%}
    </div>
  </div>

  <div class="purpose-grid__list hide-scrollbar">
    {%- for block in section.blocks -%}
      {%- liquid
        case block.settings.tone
          when 'love'
            assign c1 = '#D98BA0'
            assign c2 = '#B8546B'
          when 'wealth'
            assign c1 = '#E8A317'
            assign c2 = '#9C5A26'
          when 'health'
            assign c1 = '#9CBF8C'
            assign c2 = '#4F7A41'
          when 'success'
            assign c1 = '#8CAAC9'
            assign c2 = '#456A8F'
          when 'protection'
            assign c1 = '#B69BD1'
            assign c2 = '#7A5A9E'
          when 'clarity'
            assign c1 = '#A6A6D1'
            assign c2 = '#6B6BA3'
          else
            assign c1 = '#E0A9C4'
            assign c2 = '#B8698F'
        endcase
        assign href = block.settings.link
        if href == blank
          assign tag = block.settings.tag | default: block.settings.tone
          assign href = routes.all_products_collection_url | append: '/' | append: tag
        endif
      -%}
      <a href="{{ href }}" class="purpose{% if block.settings.hide_on_mobile %} purpose--desktop-only{% endif %}" {{ block.shopify_attributes }}>
        <span class="purpose__ring">
          <span class="purpose__orb" style="background: radial-gradient(circle at 32% 28%, {{ c1 }}, {{ c2 }});">
            {% render 'icon', icon: block.settings.icon, size: 32, class: 'purpose__icon' %}
          </span>
        </span>
        <span class="purpose__label">{{ block.settings.label }}</span>
        {%- if block.settings.label_hi != blank -%}<span class="purpose__hi" lang="hi">{{ block.settings.label_hi }}</span>{%- endif -%}
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Purpose grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Kya talash hai aapko?" },
    { "type": "text", "id": "subtitle", "label": "Hindi subtitle (optional)", "default": "अपनी मनोकामना चुनिए" }
  ],
  "blocks": [
    {
      "type": "purpose",
      "name": "Purpose",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Prem" },
        { "type": "text", "id": "label_hi", "label": "Hindi label (optional)", "default": "प्रेम" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "heart", "label": "Heart" },
            { "value": "trending-up", "label": "Trending up" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "trophy", "label": "Trophy" },
            { "value": "shield", "label": "Shield" },
            { "value": "sparkles", "label": "Sparkles" },
            { "value": "gift", "label": "Gift" }
          ],
          "default": "heart"
        },
        {
          "type": "select",
          "id": "tone",
          "label": "Colour",
          "options": [
            { "value": "love", "label": "Rose" },
            { "value": "wealth", "label": "Marigold" },
            { "value": "health", "label": "Green" },
            { "value": "success", "label": "Blue" },
            { "value": "protection", "label": "Violet" },
            { "value": "clarity", "label": "Lavender" },
            { "value": "gifting", "label": "Pink" }
          ],
          "default": "love"
        },
        { "type": "text", "id": "tag", "label": "Product tag to filter by", "info": "Links to /collections/all/<tag>. Ignored if a link is set." },
        { "type": "url", "id": "link", "label": "Link (overrides tag)" },
        { "type": "checkbox", "id": "hide_on_mobile", "label": "Hide on mobile", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "Purpose grid" }]
}
{% endschema %}
