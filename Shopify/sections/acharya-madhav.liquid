{%- assign avatar = 'acharya-icon.webp' | asset_url -%}
{%- if settings.acharya_avatar != blank -%}{%- assign avatar = settings.acharya_avatar | image_url: width: 400 -%}{%- endif -%}
<section class="acharya-sec">
  <div class="container acharya-sec__inner">
    <div class="acharya-sec__left" data-reveal>
      <div class="acharya-sec__niche">
        <img src="{{ avatar }}" alt="Acharya Madhav" width="144" height="180" loading="lazy">
      </div>
      <p class="acharya-sec__hi" lang="hi">{{ section.settings.subtitle }}</p>
      <h2 class="acharya-sec__title">{{ section.settings.heading }}</h2>
      <p class="acharya-sec__text">{{ section.settings.text }}</p>
      <button type="button" class="btn btn--kumkum" data-open-chat="I'd like a personalized recommendation based on my Vedic astrology / numerology.">
        {% render 'icon', icon: 'message-circle', size: 16 %}
        {{ section.settings.button_label }}
      </button>
    </div>

    <div class="acharya-sec__cards" data-reveal-group>
      {%- for block in section.blocks -%}
        <button type="button" class="ask-card" data-open-chat="{{ block.settings.question | escape }}" {{ block.shopify_attributes }}>
          <span class="ask-card__icon">{% render 'icon', icon: block.settings.icon, size: 18 %}</span>
          <span class="ask-card__label">{{ block.settings.label }}</span>
          <span class="ask-card__prompt">&ldquo;{{ block.settings.prompt }}&rdquo;</span>
        </button>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Acharya Madhav",
  "settings": [
    { "type": "text", "id": "subtitle", "label": "Hindi line", "default": "आचार्य से पूछिए" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Acharya Madhav" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Apne man ki baat batayein: prem, dhan, career ya swasthya. Woh aapki janm tithi se kundli aur ank-jyotish dekhkar bataenge ki kya dharan karna aapke liye shubh hai." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Acharya se baat karein" }
  ],
  "blocks": [
    {
      "type": "topic",
      "name": "Ask-him topic",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Love & Relationships" },
        { "type": "select", "id": "icon", "label": "Icon", "default": "heart", "options": [
          { "value": "heart", "label": "Heart" },
          { "value": "trending-up", "label": "Trending up" },
          { "value": "shield-check", "label": "Shield" }
        ] },
        { "type": "text", "id": "prompt", "label": "Short prompt shown on card", "default": "Which stone will help me in love and relationships?" },
        { "type": "text", "id": "question", "label": "Message sent to chat", "default": "Which stone or ritual will help me in love and relationships?" }
      ]
    }
  ],
  "presets": [{ "name": "Acharya Madhav" }]
}
{% endschema %}
