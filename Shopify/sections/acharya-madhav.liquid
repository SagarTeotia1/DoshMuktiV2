<section class="acharya-sec">
  <div class="acharya-sec__glow"></div>
  {% render 'mandala', class: 'acharya-sec__mandala' %}

  <div class="container acharya-sec__inner">
    <div class="acharya-sec__left" data-reveal>
      <div class="acharya-sec__orb">
        <svg viewBox="0 0 200 200" class="acharya-sec__kundli acharya-sec__kundli--spin" aria-hidden="true"><use href="#kundli"/></svg>
        <svg viewBox="0 0 200 200" class="acharya-sec__kundli" aria-hidden="true">
          <g id="kundli" fill="none" stroke="#C9863F" stroke-width="0.6" opacity="0.3">
            <rect x="20" y="20" width="160" height="160"/>
            <line x1="20" y1="20" x2="180" y2="180"/>
            <line x1="180" y1="20" x2="20" y2="180"/>
            <polygon points="100,20 180,100 100,180 20,100"/>
            <circle cx="100" cy="100" r="94" stroke-width="0.4" opacity="0.6"/>
          </g>
        </svg>
        <span class="acharya-sec__moon">{% render 'icon', icon: 'moon-star', size: 28 %}</span>
        <span class="acharya-sec__online"></span>
      </div>

      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="acharya-sec__title">{{ section.settings.heading }}</h2>
      <p class="acharya-sec__text">{{ section.settings.text }}</p>

      <button type="button" class="btn btn--bronze" data-open-chat="I'd like a personalized recommendation based on my Vedic astrology / numerology.">
        {% render 'icon', icon: 'message-circle', size: 14 %}
        {{ section.settings.button_label }}
      </button>
    </div>

    <div class="acharya-sec__cards" data-reveal-group>
      {%- for block in section.blocks -%}
        <button type="button" class="ask-card" data-open-chat="{{ block.settings.question | escape }}" {{ block.shopify_attributes }}>
          <span class="ask-card__icon">{% render 'icon', icon: block.settings.icon, size: 18 %}</span>
          <span class="ask-card__label">{{ block.settings.label }}</span>
          <span class="ask-card__prompt">&ldquo;{{ block.settings.prompt }}&rdquo;</span>
        </button>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Acharya Madhav",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Ancient Wisdom, On Demand" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Acharya Madhav" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Tell him what's on your mind — love, money, career, health. He reads your birth details through Vedic astrology and numerology, and tells you exactly what to wear." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Chat with Acharya Madhav" }
  ],
  "blocks": [
    {
      "type": "topic",
      "name": "Ask-him topic",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Love & Relationships" },
        { "type": "select", "id": "icon", "label": "Icon", "default": "heart", "options": [
          { "value": "heart", "label": "Heart" },
          { "value": "trending-up", "label": "Trending up" },
          { "value": "shield-check", "label": "Shield" }
        ] },
        { "type": "text", "id": "prompt", "label": "Short prompt shown on card", "default": "Which stone will help me in love and relationships?" },
        { "type": "text", "id": "question", "label": "Message sent to chat", "default": "Which stone or ritual will help me in love and relationships?" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Acharya Madhav",
      "blocks": [
        { "type": "topic", "settings": { "label": "Love & Relationships", "icon": "heart", "prompt": "Which stone will help me in love and relationships?", "question": "Which stone or ritual will help me in love and relationships?" } },
        { "type": "topic", "settings": { "label": "Wealth & Career", "icon": "trending-up", "prompt": "Is this a good time to invest or change my career?", "question": "Based on my numerology, is this a good time to invest or change my career?" } },
        { "type": "topic", "settings": { "label": "Health & Protection", "icon": "shield-check", "prompt": "How do I remove Shani dosh or negative energy?", "question": "How do I remove Shani dosh or protect myself from negative energy?" } }
      ]
    }
  ]
}
{% endschema %}
