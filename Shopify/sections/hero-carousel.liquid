{%- if section.blocks.size > 0 -%}
<section class="hero" data-carousel data-autoplay="{{ section.settings.autoplay }}" data-interval="{{ section.settings.interval | times: 1000 }}" aria-roledescription="carousel" aria-label="Featured">
  <div class="hero__slides">
    {%- for block in section.blocks -%}
      {%- assign has_image = false -%}
      {%- if block.settings.image != blank or block.settings.mobile_image != blank -%}{%- assign has_image = true -%}{%- endif -%}
      <div class="hero__slide{% if forloop.first %} is-active{% endif %}" data-slide {{ block.shopify_attributes }} {% unless forloop.first %}aria-hidden="true"{% endunless %}>
        {%- if has_image -%}
          {%- assign img = block.settings.image | default: block.settings.mobile_image -%}
          {%- assign mimg = block.settings.mobile_image | default: block.settings.image -%}
          {%- assign img_loading = 'lazy' -%}
          {%- assign img_priority = 'auto' -%}
          {%- if forloop.first -%}
            {%- assign img_loading = 'eager' -%}
            {%- assign img_priority = 'high' -%}
          {%- endif -%}
          <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="hero__link" aria-label="{{ block.settings.heading | default: 'View banner' | escape }}" {% unless forloop.first %}tabindex="-1"{% endunless %}>
            <picture>
              <source media="(max-width: 639px)" srcset="{{ mimg | image_url: width: 800 }} 800w, {{ mimg | image_url: width: 1200 }} 1200w" sizes="100vw">
              {{
                img
                | image_url: width: 2000
                | image_tag:
                  widths: '800, 1200, 1600, 2000',
                  sizes: '100vw',
                  loading: img_loading,
                  fetchpriority: img_priority,
                  alt: block.settings.heading | default: shop.name,
                  class: 'hero__img'
              }}
            </picture>
          </a>
        {%- else -%}
          <div class="hero__fallback">
            {% render 'mandala', class: 'hero__mandala' %}
            <div class="container hero__copy">
              {%- if block.settings.eyebrow != blank -%}<p class="eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
              {%- if block.settings.heading != blank -%}<h1 class="hero__title">{{ block.settings.heading }}</h1>{%- endif -%}
              {%- if block.settings.subheading != blank -%}<p class="hero__sub">{{ block.settings.subheading }}</p>{%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <a class="btn btn--primary" href="{{ block.settings.link | default: routes.all_products_collection_url }}">{{ block.settings.button_label }}</a>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="hero__nav">
      <button type="button" class="hero__arrow" data-prev aria-label="Previous slide">{% render 'icon', icon: 'chevron-left', size: 20 %}</button>
      <button type="button" class="hero__arrow" data-next aria-label="Next slide">{% render 'icon', icon: 'chevron-right', size: 20 %}</button>
    </div>
    <div class="hero__dots">
      {%- for block in section.blocks -%}
        <button type="button" class="hero__dot{% if forloop.first %} is-active{% endif %}" data-dot="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"><span></span></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>
{%- endif -%}

{% schema %}
{
  "name": "Hero carousel",
  "settings": [
    { "type": "checkbox", "id": "autoplay", "label": "Auto-rotate slides", "default": true },
    { "type": "range", "id": "interval", "min": 3, "max": 10, "step": 1, "unit": "s", "label": "Change slides every", "default": 5 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "limit": 8,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Desktop image", "info": "Recommended 1920×800." },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image", "info": "Recommended 4:3. Falls back to the desktop image." },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "header", "content": "Text fallback (used when no image)" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "subheading", "label": "Subheading" },
        { "type": "text", "id": "button_label", "label": "Button label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero carousel",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "eyebrow": "Authentic & Energized",
            "heading": "Gemstones & Astrology Remedies",
            "subheading": "For love, wealth, protection and peace — handpicked with intention.",
            "button_label": "Shop now"
          }
        }
      ]
    }
  ]
}
{% endschema %}
