{%- if section.blocks.size > 0 -%}
<section class="testimonials">
  <div class="container">
    <div class="section-head" data-reveal>
      <div class="section-head__text">
        <h2 class="section-title">{{ section.settings.heading }}</h2>
        {%- if section.settings.subtitle != blank -%}<span class="section-head__hi" lang="hi">{{ section.settings.subtitle }}</span>{%- endif -%}
      </div>
    </div>
  </div>
  <div class="testimonials__track hide-scrollbar" data-reveal-group>
    {%- for block in section.blocks -%}
      <figure class="review-card" {{ block.shopify_attributes }}>
        <div class="review-card__stars" role="img" aria-label="{{ block.settings.rating }} out of 5">
          {%- for i in (1..5) -%}
            <span class="{% if i <= block.settings.rating %}is-on{% endif %}">{% render 'icon', icon: 'star', size: 15 %}</span>
          {%- endfor -%}
        </div>
        <blockquote>{{ block.settings.text }}</blockquote>
        <figcaption>
          <strong>{{ block.settings.name }}</strong>
          {%- if block.settings.product != blank -%}
            <a href="{{ block.settings.product.url }}">{{ block.settings.product.title }}</a>
          {%- endif -%}
        </figcaption>
      </figure>
    {%- endfor -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by seekers" },
    { "type": "text", "id": "subtitle", "label": "Hindi subtitle (optional)", "default": "हमारे साधकों की बात" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "name", "label": "Customer name", "default": "Customer" },
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Rating", "default": 5 },
        { "type": "textarea", "id": "text", "label": "Review", "default": "Beautiful energized product, felt the difference within weeks." },
        { "type": "product", "id": "product", "label": "Product (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "review", "settings": { "name": "Priya S.", "rating": 5, "text": "Beautiful energized product, felt the difference within weeks." } }
      ]
    }
  ]
}
{% endschema %}
