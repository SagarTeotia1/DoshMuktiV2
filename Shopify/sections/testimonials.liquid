{%- if section.blocks.size > 0 -%}
<section class="testimonials" data-testimonials data-page-size="3">
  <div class="testimonials__head" data-reveal>
    <p class="kicker">{{ section.settings.kicker }}</p>
    <h2 class="testimonials__title">{{ section.settings.heading }}</h2>
  </div>

  <div class="testimonials__wrap">
    <button type="button" class="testimonials__arrow testimonials__arrow--desktop" data-t-prev aria-label="Previous testimonials">{% render 'icon', icon: 'chevron-left', size: 16 %}</button>

    <div class="testimonials__grid">
      {%- for block in section.blocks -%}
        <figure class="t-card" data-review {{ block.shopify_attributes }}>
          <span class="t-card__quote" aria-hidden="true">{% render 'icon', icon: 'quote', size: 20 %}</span>
          <div class="review-card__stars" role="img" aria-label="{{ block.settings.rating }} out of 5">
            {%- for i in (1..5) -%}
              <span class="{% if i <= block.settings.rating %}is-on{% endif %}">{% render 'icon', icon: 'star', size: 14 %}</span>
            {%- endfor -%}
          </div>
          <blockquote>&ldquo;{{ block.settings.text }}&rdquo;</blockquote>
          <figcaption>
            <span class="t-card__avatar">{{ block.settings.name | slice: 0 | upcase }}</span>
            <span class="t-card__who">
              <span class="t-card__name">{{ block.settings.name }}{% render 'icon', icon: 'badge-check', size: 14 %}</span>
              {%- if block.settings.product != blank -%}
                <span class="t-card__product">{{ block.settings.product.title }}</span>
              {%- endif -%}
            </span>
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>

    <button type="button" class="testimonials__arrow testimonials__arrow--desktop" data-t-next aria-label="Next testimonials">{% render 'icon', icon: 'chevron-right', size: 16 %}</button>
  </div>

  <div class="testimonials__mobile-nav">
    <button type="button" class="testimonials__arrow" data-t-prev aria-label="Previous testimonials">{% render 'icon', icon: 'chevron-left', size: 14 %}</button>
    <button type="button" class="testimonials__arrow" data-t-next aria-label="Next testimonials">{% render 'icon', icon: 'chevron-right', size: 14 %}</button>
  </div>
  <div class="testimonials__dots" data-t-dots></div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small heading", "default": "Loved By 1,000+ Customers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What Our Customers Say" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "name", "label": "Customer name", "default": "Customer" },
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Rating", "default": 5 },
        { "type": "textarea", "id": "text", "label": "Review", "default": "Write the customer's review here." },
        { "type": "product", "id": "product", "label": "Product" }
      ]
    }
  ],
  "presets": [{ "name": "Testimonials" }]
}
{% endschema %}
