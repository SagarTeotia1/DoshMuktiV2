{%- if section.blocks.size > 0 -%}
<section class="testimonials" data-testimonials data-autoplay="{{ section.settings.autoplay }}">
  <div class="testimonials__head" data-reveal>
    <p class="kicker">{{ section.settings.kicker }}</p>
    <h2 class="testimonials__title">{{ section.settings.heading }}</h2>
  </div>

  <div class="testimonials__wrap">
    <button type="button" class="testimonials__arrow testimonials__arrow--side" data-t-prev aria-label="Previous testimonials">{% render 'icon', icon: 'chevron-left', size: 16 %}</button>

    <div class="testimonials__grid" data-t-grid aria-live="polite">
      {%- for block in section.blocks -%}
        <figure class="t-card" data-review {{ block.shopify_attributes }}>
          <div class="t-card__top">
            <span class="t-card__quote" aria-hidden="true">{% render 'icon', icon: 'quote', size: 22 %}</span>
            <div class="review-card__stars" role="img" aria-label="{{ block.settings.rating }} out of 5">
              {%- for i in (1..5) -%}
                <span class="{% if i <= block.settings.rating %}is-on{% endif %}">{% render 'icon', icon: 'star', size: 15 %}</span>
              {%- endfor -%}
            </div>
          </div>

          <blockquote>&ldquo;{{ block.settings.text }}&rdquo;</blockquote>

          <figcaption>
            <span class="t-card__avatar" aria-hidden="true">{{ block.settings.name | slice: 0 | upcase }}</span>
            <span class="t-card__who">
              <span class="t-card__name">{{ block.settings.name }}<span class="t-card__verified" title="Verified buyer">{% render 'icon', icon: 'badge-check', size: 14 %}</span></span>
              {%- if block.settings.product != blank -%}
                <a class="t-card__product" href="{{ block.settings.product.url }}">{{ block.settings.product.title }}</a>
              {%- endif -%}
            </span>
            {%- if block.settings.product != blank and block.settings.product.featured_image -%}
              <a class="t-card__thumb" href="{{ block.settings.product.url }}" tabindex="-1" aria-hidden="true">
                {{ block.settings.product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '', width: 48, height: 48 }}
              </a>
            {%- endif -%}
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>

    <button type="button" class="testimonials__arrow testimonials__arrow--side" data-t-next aria-label="Next testimonials">{% render 'icon', icon: 'chevron-right', size: 16 %}</button>
  </div>

  <div class="testimonials__controls">
    <button type="button" class="testimonials__arrow testimonials__arrow--small" data-t-prev aria-label="Previous testimonials">{% render 'icon', icon: 'chevron-left', size: 14 %}</button>
    <div class="testimonials__dots" data-t-dots></div>
    <button type="button" class="testimonials__arrow testimonials__arrow--small" data-t-next aria-label="Next testimonials">{% render 'icon', icon: 'chevron-right', size: 14 %}</button>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small heading", "default": "Loved By 1,000+ Customers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What Our Customers Say" },
    { "type": "checkbox", "id": "autoplay", "label": "Auto-slide", "default": true }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "name", "label": "Customer name", "default": "Customer" },
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Rating", "default": 5 },
        { "type": "textarea", "id": "text", "label": "Review", "default": "Write the customer's review here." },
        { "type": "product", "id": "product", "label": "Product" }
      ]
    }
  ],
  "presets": [{ "name": "Testimonials" }]
}
{% endschema %}
