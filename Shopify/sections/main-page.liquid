<article class="container page-content">
  <header class="page-content__head">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="page-title">{{ page.title }}</h1>
  </header>
  <div class="rte rte--page">{{ page.content }}</div>
</article>

{% schema %}
{
  "name": "Page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Doshmukti" }
  ]
}
{% endschema %}
