<article class="container page-content article">
  <header class="page-content__head">
    <p class="eyebrow"><time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%B %d, %Y' }}</time>{% if article.author != blank %} · {{ article.author }}{% endif %}</p>
    <h1 class="page-title">{{ article.title }}</h1>
  </header>
  {%- if article.image -%}
    <div class="article__hero">{{ article.image | image_url: width: 1400 | image_tag: widths: '700, 1000, 1400', sizes: '(min-width: 900px) 800px, 100vw', alt: article.image.alt | default: article.title, fetchpriority: 'high' }}</div>
  {%- endif -%}
  <div class="rte rte--page">{{ article.content }}</div>
  <p><a class="btn btn--secondary btn--sm" href="{{ blog.url }}">← {{ blog.title }}</a></p>
</article>

{% schema %}
{ "name": "Article" }
{% endschema %}
