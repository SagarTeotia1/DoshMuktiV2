<div
  class="rail rail--tinted"
  data-recommendations
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="container">
      <div class="rail__head related__head">
        <p class="kicker">You May Also Like</p>
        <h2 class="related__title">{{ section.settings.heading }}</h2>
      </div>
    </div>
    <div class="rail__track hide-scrollbar">
      {%- for p in recommendations.products -%}
        <div class="rail__item">{% render 'product-card', product: p, list_name: 'related' %}</div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete The Ritual" },
    { "type": "range", "id": "limit", "min": 4, "max": 10, "step": 1, "label": "Products", "default": 8 }
  ]
}
{% endschema %}
