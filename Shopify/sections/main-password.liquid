<section class="password-page">
  {% render 'mandala', class: 'password-page__mandala' %}
  <div class="password-page__card">
    {%- if settings.logo != blank -%}
      {{ settings.logo | image_url: width: 400 | image_tag: height: 64, alt: shop.name }}
    {%- else -%}
      <img src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name }}" width="204" height="64">
    {%- endif -%}
    <h1>{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}<div class="rte">{{ shop.password_message }}</div>{%- endif -%}

    {%- form 'storefront_password', class: 'form' -%}
      {%- if form.errors -%}<div class="form-error">{{ form.errors | default_errors }}</div>{%- endif -%}
      <label class="field"><span>Enter password</span>
        <input class="input" type="password" name="password" required autocomplete="current-password"></label>
      <button type="submit" class="btn btn--primary btn--block">Enter</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" }
  ]
}
{% endschema %}
