<section class="container page-content faq">
  <header class="page-content__head">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="page-title">{{ section.settings.heading | default: page.title }}</h1>
  </header>
  <div class="accordion accordion--faq">
    {%- for block in section.blocks -%}
      <details class="accordion__item" id="faq-{{ block.id }}" {{ block.shopify_attributes }}>
        <summary>{{ block.settings.question }} {% render 'icon', icon: 'chevron-down', size: 16 %}</summary>
        <div class="rte">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
    {
      "@type": "Question",
      "name": {{ block.settings.question | json }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Help" },
    { "type": "text", "id": "heading", "label": "Heading (defaults to page title)" }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does delivery take?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Orders are dispatched within 24–48 hours and usually arrive in 5–7 business days across India.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "qa", "settings": { "question": "How long does delivery take?", "answer": "<p>Orders are dispatched within 24–48 hours and usually arrive in 5–7 business days across India.</p>" } },
        { "type": "qa", "settings": { "question": "Are your products authentic and energized?", "answer": "<p>Yes. Every piece is sourced from verified artisans and ritually energized before dispatch.</p>" } },
        { "type": "qa", "settings": { "question": "What is your returns policy?", "answer": "<p>Damaged or incorrect items can be reported within 48 hours of delivery for a free replacement. Eligible orders also qualify for a 7-day return.</p>" } }
      ]
    }
  ]
}
{% endschema %}
