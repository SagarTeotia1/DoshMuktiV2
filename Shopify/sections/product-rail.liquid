{%- liquid
  assign col = section.settings.collection
  if col == blank
    assign col = collections['all']
  endif
  assign products = col.products
-%}
{%- if products.size > 0 -%}
<section class="rail{% if section.settings.tinted %} rail--tinted torana{% endif %}">
  <div class="container">
    <div class="section-head rail__head" data-reveal>
      <div class="section-head__text">
        <h2 class="section-title">{{ section.settings.heading }}</h2>
        {%- if section.settings.subtitle != blank -%}<span class="section-head__hi" lang="hi">{{ section.settings.subtitle }}</span>{%- endif -%}
      </div>
      {%- if section.settings.show_view_all and col.url != blank -%}
        <a class="section-head__more" href="{{ col.url }}">Sab dekhein</a>
      {%- endif -%}
    </div>
  </div>

  <div class="rail__track hide-scrollbar" data-reveal-group>
    {%- for product in products limit: section.settings.limit -%}
      <div class="rail__item">{% render 'product-card', product: product, list_name: section.settings.heading %}</div>
    {%- endfor -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Product rail",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Handpicked this week" },
    { "type": "text", "id": "subtitle", "label": "Hindi subtitle (optional)" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Falls back to all products." },
    { "type": "range", "id": "limit", "min": 4, "max": 16, "step": 1, "label": "Products to show", "default": 10 },
    { "type": "checkbox", "id": "tinted", "label": "Tinted background with torana edge", "default": false },
    { "type": "checkbox", "id": "show_view_all", "label": "Show “Sab dekhein” link", "default": true }
  ],
  "presets": [{ "name": "Product rail" }]
}
{% endschema %}
