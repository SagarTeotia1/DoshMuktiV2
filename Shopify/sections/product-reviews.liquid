{%- assign data = product.metafields.custom.reviews.value -%}
{%- if data.total > 0 -%}
<section class="reviews container" id="reviews">
  <div class="reviews__head">
    <p class="kicker">From Our Customers</p>
    <h2 class="reviews__title">Customer Reviews</h2>
  </div>

  <div class="reviews__summary">
    <div class="reviews__avg-wrap">
      <span class="reviews__avg">{{ data.average | round: 1 }}</span>
      {% render 'stars', rating: data.average, size: 16 %}
      <p>{{ data.total }} review{% if data.total != 1 %}s{% endif %}</p>
    </div>
    <div class="reviews__bars">
      {%- for i in (1..5) reversed -%}
        {%- assign key = i | append: '' -%}
        {%- assign count = data.counts[key] | default: 0 -%}
        {%- assign pct = count | times: 100 | divided_by: data.total -%}
        <div class="reviews__bar"><span>{{ i }}★</span><i><b style="width: {{ pct }}%"></b></i><span>{{ pct }}%</span></div>
      {%- endfor -%}
    </div>
  </div>

  <div class="reviews__list">
    {%- for item in data.items limit: 12 -%}
      <article class="review">
        <span class="review__quote" aria-hidden="true">“</span>
        <div class="review__head">
          <span class="review__avatar">{{ item.name | slice: 0 | upcase }}</span>
          <div>
            <p class="review__name">{{ item.name }}</p>
            <p class="review__date">{{ item.date | date: '%d %b %Y' }}</p>
          </div>
        </div>
        {% render 'stars', rating: item.rating, size: 14 %}
        {%- if item.title != blank -%}<p class="review__title">{{ item.title }}</p>{%- endif -%}
        <p class="review__body">{{ item.body }}</p>
      </article>
    {%- endfor -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Product reviews"
}
{% endschema %}
