# ── Server ──────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
# Publicly reachable base URL of THIS backend — SmartGateway redirects the customer's
# browser here after payment, so this can't be localhost outside of local dev.
BACKEND_PUBLIC_URL=http://localhost:4000

# ── Database (Neon) ────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.ap-south-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:pass@ep-xxx.ap-south-1.aws.neon.tech/neondb?sslmode=require"

# ── Admin Auth ──────────────────────────────────────────────────────────
JWT_SECRET=""                # openssl rand -base64 32
ADMIN_EMAIL="admin@doshhmukti.com"
ADMIN_PASSWORD_HASH=""       # bcrypt hash — generate with bcryptjs, never store plaintext

# ── Future AI bot (stubbed, unused today) ──────────────────────────────
AI_BOT_SERVICE_KEY=""

# ── Upstash Redis ───────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── HDFC SmartGateway (expresscheckout) ─────────────────────────────────
# Merchant Id / Client Id — same value, provided by the bank during onboarding
HDFC_MERCHANT_ID=""
# 'hdfcmaster' for sandbox; the bank-provided value in production
HDFC_PAYMENT_PAGE_CLIENT_ID="hdfcmaster"
# Dashboard → Payments → Settings → Security → JWT Keys
HDFC_KEY_UUID=""
# PEM contents (not a file path) — merchant's private key, kept out of the client bundle,
# never logged. Generate: openssl genrsa -out private-key.pem 2048
HDFC_PRIVATE_KEY=""
# PEM contents — the bank's public key, downloaded from the Dashboard
HDFC_PUBLIC_KEY=""
# Dashboard → Settings → General → "Use signed response" Response Key — verifies the
# return_url redirect's signature
HDFC_RESPONSE_KEY=""
# Sandbox: https://smartgateway.hdfcuat.bank.in — Production: https://smartgateway.hdfc.bank.in
HDFC_BASE_URL="https://smartgateway.hdfcuat.bank.in"
# Dashboard → Payments → Settings → Webhook — Basic Auth credentials SmartGateway sends
# back on every webhook call
HDFC_WEBHOOK_USERNAME=""
HDFC_WEBHOOK_PASSWORD=""

# ── Cloudflare R2 ────────────────────────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="doshhmukti-images"
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"

# ── Resend ───────────────────────────────────────────────────────────────
RESEND_API_KEY="re_xxxx"
RESEND_FROM_EMAIL="orders@doshhmukti.com"

# ── Delhivery ────────────────────────────────────────────────────────────
DELHIVERY_API_KEY=""
DELHIVERY_WEBHOOK_TOKEN=""   # shared secret — set same value as custom header in Delhivery's webhook push-API config
DELHIVERY_BASE_URL="https://staging-express.delhivery.com"
DELHIVERY_WAREHOUSE_NAME="Doshhmukti Warehouse"
DELHIVERY_WAREHOUSE_PINCODE="110001"
DELHIVERY_WAREHOUSE_CITY="New Delhi"
DELHIVERY_WAREHOUSE_STATE="Delhi"
DELHIVERY_WAREHOUSE_ADDRESS=""
DELHIVERY_WAREHOUSE_PHONE=""
DELHIVERY_CLIENT_NAME="Doshhmukti"

# ── 2Factor.in (OTP — phone verification) ───────────────────────────────
TWOFACTOR_API_KEY=""

# ── OpenRouter (Acharya Madhav chatbot) ────────────────────────────────
OPENROUTER_API_KEY=""         # openrouter.ai/keys
OPENROUTER_MODEL="google/gemini-2.5-flash"   # fast + cheap, strong Hinglish

# ── Cron Security ────────────────────────────────────────────────────────
CRON_SECRET=""                # openssl rand -base64 32 (min 32 chars)
