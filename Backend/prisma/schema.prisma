generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Product ──────────────────────────────────────────────────────────────────

model Product {
  id                       String           @id @default(cuid())
  name                     String
  slug                     String           @unique
  description              Json             @default("[]") // DescriptionBlock[] — ordered [{type:'text',content} | {type:'image',thumb,card,full}], admin-composed, see products/schema.ts
  categories               String[]         @default([]) // ["Bracelets","Pyrite Items",...] — a product can be shared across multiple categories, first entry treated as primary wherever a single category is needed (breadcrumbs, GST/chat grouping)
  basePrice                Decimal          @db.Decimal(10, 2)
  compareAtPrice           Decimal?         @db.Decimal(10, 2) // strikethrough "MRP" — null = no discount shown
  images                   Json             @default("[]") // [{thumb,card,full}]
  status                   ProductStatus    @default(DRAFT)
  purpose                  String[]         @default([]) // ["love","wealth",...]
  featured                 Boolean          @default(false)
  badge                    String? // "Bestseller"|"New"|"Limited Edition"
  benefits                 Json             @default("[]") // [{title, description}]
  howToWear                Json             @default("[]") // ["step 1", "step 2", ...]
  careInstructions         String?          @db.Text
  socialProofText          String? // "Loved by 15 lakh+ customers"
  tags                     String[]         @default([]) // ["Bestseller", "New", ...] — admin-managed display tags
  howToUseVideoUrl         String? // YouTube/Vimeo/mp4 URL, shown in the "How to Use" section
  testimonialVideos        Json             @default("[]") // TestimonialVideo[] — [{id, videoUrl, posterUrl, caption, views}], shown as "Loved by X customers" row on PDP
  sidhiPrice               Int? // ₹ price for the Sidhi/Energizing service add-on; null = feature hidden. Syncs to a "-SIDHI" ProductVariant — see products/service.ts
  selfEnergizeInstructions String?          @db.Text // DIY energizing steps, shown as the "Energize It Yourself" tab
  gstRate                  Decimal?         @db.Decimal(5, 2) // GST %, e.g. 18.00; admin-set per product, null = no GST line on invoice. Snapshotted into OrderItem.variantSnapshot.gstRate at checkout — see checkout/service.ts
  // Admin override for the 7-day return policy. null = default rule (basePrice >=
  // RETURN_ELIGIBLE_ABOVE is returnable, below it is final sale — see products/service.ts's
  // resolveReturnEligible). true/false lets an admin force a specific product either way
  // regardless of price, e.g. allow returns on a sub-₹299 item or block them on an
  // expensive one that's non-returnable for other reasons.
  returnEligibleOverride   Boolean?
  offers                   Offer[]          @relation("OfferProducts") // universal, admin-managed offers enabled on this product — see Offer model
  variants                 ProductVariant[]
  reviews                  Review[]
  homepageSectionItems     HomepageSectionItem[]
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  @@index([status])
  @@index([status, featured])
  @@index([slug])
}

enum OfferBehavior {
  DISPLAY_ONLY // pure marketing banner — never evaluated at checkout
  AUTO_APPLIED // reward applies automatically whenever an enabled product is in the cart
  COUPON_BASED // reward only applies when the linked Coupon code is redeemed — see couponId
}

enum OfferReward {
  DISPLAY_MESSAGE // banner-only, no monetary effect
  PERCENTAGE_DISCOUNT
  FLAT_DISCOUNT
  FREE_GIFT
  BUY_X_GET_Y
  FREE_SHIPPING
}

enum OfferScope {
  SPECIFIC_PRODUCTS // applies only to products explicitly linked via the `products` relation
  CATEGORY // applies to every product where Product.category == Offer.category, no explicit links needed
  ALL_PRODUCTS // applies store-wide to every product, no explicit links needed
}

// Universal, reusable offers (e.g. "Buy 2 Get 1 Free") — created once, then
// either linked to specific products, matched against a whole Product.category, or applied
// store-wide, per `scope`. Never delete, only isActive:false.
// `behavior` decides WHEN the reward activates, `reward` decides WHAT the customer gets —
// they vary independently (e.g. a FREE_GIFT can be DISPLAY_ONLY-teased or AUTO_APPLIED).
// `config` carries reward-specific data, shape defined per-reward in
// src/modules/offers/rewards/*.ts and enforced by the Zod schema in offers/schema.ts.
// Adding a new reward is a new file in rewards/, never a new column here.
// Which offers actually apply to a given product is NOT just `products.some(...)` once scope
// exists — see offers/service.ts's getApplicableOffersForProduct, the single source of truth
// every read path (storefront, checkout, admin) must go through.
model Offer {
  id       String        @id @default(cuid())
  title    String
  behavior OfferBehavior @default(DISPLAY_ONLY)
  reward   OfferReward   @default(DISPLAY_MESSAGE)
  config   Json          @default("{}")
  isActive Boolean       @default(true)

  scope    OfferScope @default(SPECIFIC_PRODUCTS)
  products Product[]  @relation("OfferProducts") // used only when scope = SPECIFIC_PRODUCTS
  category String? // used only when scope = CATEGORY — matches Product.category

  couponId String? // set only when behavior = COUPON_BASED
  coupon   Coupon? @relation(fields: [couponId], references: [id])

  // Optional spend threshold, independent of reward/behavior (not part of `config` — every
  // reward can have one, so it lives at the top level like scope/category do). Enforced at
  // checkout only for AUTO_APPLIED (the reward doesn't apply below this cart subtotal).
  // Informational-only for DISPLAY_ONLY (never evaluated at checkout anyway — it's just
  // teaser copy). Not meant for COUPON_BASED — Coupon.minOrder already serves that role
  // there; this field is left settable but ignored by checkout for that behavior to avoid
  // two competing conditions on one redemption.
  minOrderValue Decimal? @db.Decimal(10, 2)

  // Opt-in only — an admin curates a small, deliberate set to surface in the storefront's
  // site-wide "Suggested Offers" widget (see /offers/suggestions). Independent of isActive:
  // archiving still hides it everywhere including here, but most active offers stay off
  // this list by default so the widget doesn't just mirror the entire offer catalog.
  showInSuggestions Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([behavior])
  @@index([reward])
  @@index([couponId])
  @@index([scope, category])
  @@index([showInSuggestions])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model ProductVariant {
  id                String          @id @default(cuid())
  productId         String
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String          @unique
  attributes        Json            @default("{}") // {size,color,material}
  priceOverride     Decimal?        @db.Decimal(10, 2)
  stockQuantity     Int             @default(0)
  lowStockThreshold Int             @default(5)
  weight            Int             @default(500) // grams
  isActive          Boolean         @default(true)
  stockMovements    StockMovement[]
  orderItems        OrderItem[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([productId])
  @@index([sku])
}

model StockMovement {
  id        String              @id @default(cuid())
  variantId String
  variant   ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  change    Int
  reason    StockMovementReason
  orderId   String?
  note      String?
  createdAt DateTime            @default(now())
  createdBy String

  @@index([variantId, createdAt])
  @@index([orderId])
}

enum StockMovementReason {
  RESTOCK
  SALE
  MANUAL_ADJUSTMENT
  RETURN
  RESERVATION_RELEASED
}

// ─── Customer Identity ────────────────────────────────────────────────────────

// Saved address keyed on SHA-256(phone) — never store raw phone in cache
model CustomerAddress {
  id            String   @id @default(cuid())
  phoneHash     String // SHA-256 of normalized ACCOUNT phone (+91XXXXXXXXXX) — the logged-in
  // customer, for lookup. Separate from receiverPhone below (who actually receives the parcel —
  // may be a different number, e.g. ordering for family).
  receiverPhone String   @default("") // normalized +91XXXXXXXXXX
  name          String
  line1         String
  line2         String?
  city          String
  state         String
  pincode       String
  country       String   @default("IN")
  isDefault     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([phoneHash])
}

// Logged-in customer — created on first successful OTP verification.
// Identity is the phone number; login is OTP-only, no password ever stored.
model User {
  id        String    @id @default(cuid())
  phone     String    @unique // normalized +91XXXXXXXXXX
  name      String? // null until the customer's first checkout — no longer collected at login
  dob       DateTime?
  orders    Order[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([phone])
}

// OTP state — cleaned up by cron after expiry
model OtpVerification {
  id        String   @id @default(cuid())
  phone     String // normalized: +91XXXXXXXXXX
  requestId String // 2Factor.in session ID returned on send
  verified  Boolean  @default(false)
  expiresAt DateTime // 10 min from creation
  createdAt DateTime @default(now())

  @@index([phone, verified])
  @@index([expiresAt])
}

// ─── Order ───────────────────────────────────────────────────────────────────

model OrderSequence {
  date String @id // YYYYMMDD
  seq  Int    @default(0)
}

model Order {
  id                   String           @id @default(cuid())
  orderNumber          String           @unique // DOSH-20240615-0042
  userId               String? // logged-in customer this order belongs to — nullable for orders placed before accounts existed
  user                 User?            @relation(fields: [userId], references: [id])
  customerName         String
  customerPhone        String // primary identifier
  customerEmail        String? // optional
  customerDob          DateTime? // optional — for birthday coupons
  shippingAddress      Json // {line1,line2?,city,state,pincode,country}
  status               OrderStatus      @default(PENDING_PAYMENT)
  subtotal             Decimal          @db.Decimal(10, 2)
  shippingFee          Decimal          @db.Decimal(10, 2)
  discountAmount       Decimal          @default(0) @db.Decimal(10, 2)
  total                Decimal          @db.Decimal(10, 2)
  couponId             String?
  coupon               Coupon?          @relation(fields: [couponId], references: [id])
  rewardPointsEarned   Int              @default(0)
  rewardPointsRedeemed Int              @default(0)
  reservedUntil        DateTime?
  items                OrderItem[]
  payment              Payment?
  shipment             Shipment?
  statusLog            OrderStatusLog[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([customerPhone])
  @@index([orderNumber])
  @@index([reservedUntil])
  @@index([couponId])
  @@index([userId])
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  REFUNDED
  PACKED
}

model OrderItem {
  id              String         @id @default(cuid())
  orderId         String
  order           Order          @relation(fields: [orderId], references: [id])
  variantId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id])
  quantity        Int
  priceAtPurchase Decimal        @db.Decimal(10, 2)
  variantSnapshot Json // {sku,attributes,productName} — point-in-time

  @@index([orderId])
}

model OrderStatusLog {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id])
  from      OrderStatus
  to        OrderStatus
  note      String?
  createdAt DateTime    @default(now())
  createdBy String

  @@index([orderId])
}

// ─── Payment ──────────────────────────────────────────────────────────────────

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id])
  razorpayOrderId   String        @unique
  razorpayPaymentId String?
  razorpaySignature String?
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  verifiedAt        DateTime?
  failureReason     String?
  // Set when an admin cancels a prepaid order before delivery — see
  // orders/service.ts's updateOrderStatus. Null means never refunded.
  razorpayRefundId  String?
  refundedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
}

// ─── Shipment ─────────────────────────────────────────────────────────────────

model Shipment {
  id                String         @id @default(cuid())
  orderId           String         @unique
  order             Order          @relation(fields: [orderId], references: [id])
  delhiveryWaybill  String?
  status            ShipmentStatus @default(PENDING)
  trackingEvents    Json           @default("[]") // [{timestamp,status,location,description}]
  estimatedDelivery DateTime?
  // Government e-way bill number (GST-required above the transport value threshold) —
  // generated externally (GST portal/GSP), just attached here and pushed to Delhivery.
  ewaybillNumber    String?
  // Set once this shipment is swept into a batch pickup request — lets the UI show
  // "already in a pickup batch" instead of letting an admin double-count it into a
  // second batch. Null means "booked, still waiting to be picked up."
  pickupRequestId   String?
  pickupRequest     PickupRequest? @relation(fields: [pickupRequestId], references: [id])
  // Set from Delhivery's NDR remarks (keyword match on tracking event description) or
  // by an admin manually flagging the order — surfaces "don't sweep this into the next
  // pickup batch, and don't retry blindly" before a courier wastes a trip on it. Cleared
  // when an NDR action (REATTEMPT/RTO) is taken, since that's the admin resolving it.
  riskFlag          ShipmentRiskFlag?
  riskReason         String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([status])
  @@index([delhiveryWaybill])
  @@index([pickupRequestId])
  @@index([riskFlag])
}

enum ShipmentRiskFlag {
  BAD_ADDRESS
  HIGH_RISK
}

enum ShipmentStatus {
  PENDING
  BOOKED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

// One Delhivery pickup slot covering every BOOKED-but-not-yet-picked-up shipment at
// request time (see pickup-requests/service.ts) — never one row per order. A single
// courier visit collects the whole day's bag, so `expectedPackageCount` is the count
// of Shipments swept into this batch, not a per-order number.
model PickupRequest {
  id                    String              @id @default(cuid())
  pickupDate            String // YYYY-MM-DD
  pickupTime            String // HH:MM
  expectedPackageCount  Int
  delhiveryPickupId     String?
  status                PickupRequestStatus @default(REQUESTED)
  failureReason         String?
  shipments             Shipment[]
  createdAt             DateTime            @default(now())
  createdBy             String

  @@index([status])
  @@index([createdAt])
}

enum PickupRequestStatus {
  REQUESTED
  FAILED
}

// ─── Coupons ──────────────────────────────────────────────────────────────────

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  type        CouponType
  value       Decimal    @db.Decimal(10, 2) // ₹ amount or % value
  minOrder    Decimal?   @db.Decimal(10, 2) // minimum order subtotal
  maxUses     Int? // null = unlimited
  usedCount   Int        @default(0)
  maxDiscount Decimal?   @db.Decimal(10, 2) // cap for PERCENT type
  expiresAt   DateTime?
  isActive    Boolean    @default(true)
  orders      Order[]
  offers      Offer[] // offers with behavior = COUPON_BASED that activate when this code is redeemed
  createdAt   DateTime   @default(now())

  // Same opt-in "curated, not everything" rule as Offer.showInSuggestions — a standalone
  // coupon (no linked Offer) can also surface in the suggestions widget on its own.
  showInSuggestions Boolean @default(false)

  @@index([code])
  @@index([isActive, expiresAt])
  @@index([showInSuggestions])
}

enum CouponType {
  FLAT
  PERCENT
  BIRTHDAY
}

// ─── Rewards ──────────────────────────────────────────────────────────────────

// Append-only ledger — never UPDATE or DELETE
model RewardPoint {
  id        String            @id @default(cuid())
  phoneHash String // SHA-256(+91XXXXXXXXXX)
  orderId   String? // null for manual grants/deductions
  change    Int // positive = earned, negative = redeemed/expired
  balance   Int // running total after this entry (denormalized)
  reason    RewardPointReason
  expiresAt DateTime? // earned points expire 12 months after earning
  createdAt DateTime          @default(now())

  @@index([phoneHash, createdAt])
  @@index([orderId])
  @@index([expiresAt])
}

enum RewardPointReason {
  ORDER_EARNED // +points on paid order
  ORDER_REDEEMED // -points used at checkout
  BIRTHDAY_BONUS // +points on birthday
  MANUAL_GRANT // admin grant
  MANUAL_DEDUCT // admin correction
  EXPIRED // -points on expiry
}

// ─── Reviews ────────────────────────────────────────────────────────────────

model Review {
  id           String       @id @default(cuid())
  productId    String
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerName String
  rating       Int // 1-5
  title        String?
  body         String       @db.Text
  status       ReviewStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([productId, status])
  @@index([status, createdAt])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── Chat / Book Grounding ────────────────────────────────────────────────────

// One chunk (roughly a paragraph, ~500-1000 chars) of reference-book text used to ground
// Acharya Madhav's chat replies. `source` is a human label (book title/filename) so
// multiple books/sections can coexist later. Populated by scripts/ingest-book.ts — empty
// until the owner provides book content; retrieval treats zero rows as "not ingested yet",
// not an error.
model BookChunk {
  id        String                    @id @default(cuid())
  source    String
  content   String                    @db.Text
  // 384-dim vector from Xenova/multilingual-e5-small (Transformers.js, in-process, free).
  // Prisma has no native vector type — Unsupported() opts this column out of the generated
  // client's normal read/write API; all access goes through $queryRaw/$executeRaw in
  // ingest-book.ts and bookRetrieval.ts. Nullable: rows ingested before embeddings existed
  // (or if the embedding pipeline fails at ingest time) keep working via keyword fallback.
  embedding Unsupported("vector(384)")?
  createdAt DateTime                  @default(now())

  @@index([source])
}

// ─── Banners ────────────────────────────────────────────────────────────────

model Banner {
  id          String   @id @default(cuid())
  image       Json // {thumb, card, full} — same shape as Product.images, from /admin/upload
  mobileImage Json? // optional art-directed crop for narrow screens, same {thumb, card, full} shape — falls back to `image` when absent
  link        String // wherever the banner should navigate on click — internal path or full URL
  order       Int      @default(0) // display order, ascending
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, order])
}

// ─── Homepage Sections ──────────────────────────────────────────────────────

// Admin-controlled homepage product rails — lets an admin rename a rail's display
// title and curate/reorder exactly which products appear in it, without a deploy.
// `key` is a stable slug used only to identify the rail across deploys/seeds; it is
// never shown to shoppers — `title` is what renders on the storefront.
model HomepageSection {
  id        String                @id @default(cuid())
  key       String                @unique
  title     String
  order     Int                   @default(0)
  isActive  Boolean               @default(true)
  items     HomepageSectionItem[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
}

model HomepageSectionItem {
  id        String          @id @default(cuid())
  sectionId String
  section   HomepageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  order     Int             @default(0) // product position within the section; 0 = first

  @@unique([sectionId, productId])
  @@index([sectionId, order])
}
