generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Product ──────────────────────────────────────────────────────────────────

model Product {
  id                       String           @id @default(cuid())
  name                     String
  slug                     String           @unique
  description              String           @db.Text
  category                 String
  basePrice                Decimal          @db.Decimal(10, 2)
  compareAtPrice           Decimal?         @db.Decimal(10, 2) // strikethrough "MRP" — null = no discount shown
  images                   Json             @default("[]") // [{thumb,card,full}]
  status                   ProductStatus    @default(DRAFT)
  purpose                  String[]         @default([]) // ["love","wealth",...]
  featured                 Boolean          @default(false)
  badge                    String? // "Bestseller"|"New"|"Limited Edition"
  benefits                 Json             @default("[]") // [{title, description}]
  howToWear                Json             @default("[]") // ["step 1", "step 2", ...]
  careInstructions         String?          @db.Text
  socialProofText          String? // "Loved by 15 lakh+ customers"
  tags                     String[]         @default([]) // ["100% Cashback in Wallet", "New", ...] — admin-managed display tags
  cashbackPercent          Int? // % of paid price credited to wallet when order is marked PAID; null = no cashback
  descriptionImages        Json             @default("[]") // [{thumb,card,full}] — contextual photos shown alongside the description, same shape as `images`
  howToUseVideoUrl         String? // YouTube/Vimeo/mp4 URL, shown in the "How to Use" section
  sidhiPrice               Int? // ₹ price for the Sidhi/Energizing service add-on; null = feature hidden. Syncs to a "-SIDHI" ProductVariant — see products/service.ts
  selfEnergizeInstructions String?          @db.Text // DIY energizing steps, shown as the "Energize It Yourself" tab
  offers                   Offer[]          @relation("OfferProducts") // universal, admin-managed offers enabled on this product — see Offer model
  freeItemOffers           Offer[]          @relation("OfferFreeProduct") // offers that ship this product for free — see Offer.freeProductId
  variants                 ProductVariant[]
  reviews                  Review[]
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  @@index([status, category])
  @@index([status, featured])
  @@index([slug])
}

enum OfferType {
  DISPLAY // pure marketing tag, no backend effect
  FREE_ITEM // auto-ships Offer.freeProduct at ₹0 with the order
  CASHBACK // credits wallet — sums with Product.cashbackPercent, doesn't replace it
  DISCOUNT // reduces order total automatically, no coupon code needed
}

enum OfferDiscountType {
  FLAT
  PERCENT
}

// Universal, reusable offers (e.g. "100% Cashback on First Order") — created once,
// enabled per-product via the Product.offers relation. Never delete, only isActive:false.
model Offer {
  id       String    @id @default(cuid())
  title    String
  type     OfferType @default(DISPLAY)
  isActive Boolean   @default(true)
  products Product[] @relation("OfferProducts")

  cashbackPercent Int? // CASHBACK — % credited to wallet, summed with Product.cashbackPercent

  discountType  OfferDiscountType? // DISCOUNT
  discountValue Decimal?           @db.Decimal(10, 2)
  maxDiscount   Decimal?           @db.Decimal(10, 2) // cap for PERCENT, mirrors Coupon.maxDiscount

  freeProductId String? // FREE_ITEM — which product ships free
  freeProduct   Product? @relation("OfferFreeProduct", fields: [freeProductId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([type])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model ProductVariant {
  id                String          @id @default(cuid())
  productId         String
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String          @unique
  attributes        Json            @default("{}") // {size,color,material}
  priceOverride     Decimal?        @db.Decimal(10, 2)
  stockQuantity     Int             @default(0)
  lowStockThreshold Int             @default(5)
  weight            Int             @default(500) // grams
  isActive          Boolean         @default(true)
  stockMovements    StockMovement[]
  orderItems        OrderItem[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([productId])
  @@index([sku])
}

model StockMovement {
  id        String              @id @default(cuid())
  variantId String
  variant   ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  change    Int
  reason    StockMovementReason
  orderId   String?
  note      String?
  createdAt DateTime            @default(now())
  createdBy String

  @@index([variantId, createdAt])
  @@index([orderId])
}

enum StockMovementReason {
  RESTOCK
  SALE
  MANUAL_ADJUSTMENT
  RETURN
  RESERVATION_RELEASED
}

// ─── Customer Identity ────────────────────────────────────────────────────────

// Saved address keyed on SHA-256(phone) — never store raw phone in cache
model CustomerAddress {
  id        String   @id @default(cuid())
  phoneHash String // SHA-256 of normalized phone (+91XXXXXXXXXX)
  name      String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  country   String   @default("IN")
  isDefault Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phoneHash])
}

// Logged-in customer — created on first successful OTP verification.
// Identity is the phone number; login is OTP-only, no password ever stored.
model User {
  id        String    @id @default(cuid())
  phone     String    @unique // normalized +91XXXXXXXXXX
  name      String
  dob       DateTime?
  orders    Order[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([phone])
}

// OTP state — cleaned up by cron after expiry
model OtpVerification {
  id        String   @id @default(cuid())
  phone     String // normalized: +91XXXXXXXXXX
  requestId String // MSG91 request ID returned on send
  verified  Boolean  @default(false)
  expiresAt DateTime // 10 min from creation
  createdAt DateTime @default(now())

  @@index([phone, verified])
  @@index([expiresAt])
}

// ─── Order ───────────────────────────────────────────────────────────────────

model OrderSequence {
  date String @id // YYYYMMDD
  seq  Int    @default(0)
}

model Order {
  id                   String           @id @default(cuid())
  orderNumber          String           @unique // DOSH-20240615-0042
  userId               String? // logged-in customer this order belongs to — nullable for orders placed before accounts existed
  user                 User?            @relation(fields: [userId], references: [id])
  customerName         String
  customerPhone        String // primary identifier
  customerEmail        String? // optional
  customerDob          DateTime? // optional — for birthday coupons
  shippingAddress      Json // {line1,line2?,city,state,pincode,country}
  status               OrderStatus      @default(PENDING_PAYMENT)
  subtotal             Decimal          @db.Decimal(10, 2)
  shippingFee          Decimal          @db.Decimal(10, 2)
  discountAmount       Decimal          @default(0) @db.Decimal(10, 2)
  walletRedeemed       Decimal          @default(0) @db.Decimal(10, 2)
  total                Decimal          @db.Decimal(10, 2)
  couponId             String?
  coupon               Coupon?          @relation(fields: [couponId], references: [id])
  rewardPointsEarned   Int              @default(0)
  rewardPointsRedeemed Int              @default(0)
  reservedUntil        DateTime?
  items                OrderItem[]
  payment              Payment?
  shipment             Shipment?
  statusLog            OrderStatusLog[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([customerPhone])
  @@index([orderNumber])
  @@index([reservedUntil])
  @@index([couponId])
  @@index([userId])
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  REFUNDED
}

model OrderItem {
  id              String         @id @default(cuid())
  orderId         String
  order           Order          @relation(fields: [orderId], references: [id])
  variantId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id])
  quantity        Int
  priceAtPurchase Decimal        @db.Decimal(10, 2)
  variantSnapshot Json // {sku,attributes,productName} — point-in-time

  @@index([orderId])
}

model OrderStatusLog {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id])
  from      OrderStatus
  to        OrderStatus
  note      String?
  createdAt DateTime    @default(now())
  createdBy String

  @@index([orderId])
}

// ─── Payment ──────────────────────────────────────────────────────────────────

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id])
  razorpayOrderId   String        @unique
  razorpayPaymentId String?
  razorpaySignature String?
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  verifiedAt        DateTime?
  failureReason     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
}

// ─── Shipment ─────────────────────────────────────────────────────────────────

model Shipment {
  id                String         @id @default(cuid())
  orderId           String         @unique
  order             Order          @relation(fields: [orderId], references: [id])
  delhiveryWaybill  String?
  status            ShipmentStatus @default(PENDING)
  trackingEvents    Json           @default("[]") // [{timestamp,status,location,description}]
  estimatedDelivery DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([status])
  @@index([delhiveryWaybill])
}

enum ShipmentStatus {
  PENDING
  BOOKED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

// ─── Coupons ──────────────────────────────────────────────────────────────────

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  type        CouponType
  value       Decimal    @db.Decimal(10, 2) // ₹ amount or % value
  minOrder    Decimal?   @db.Decimal(10, 2) // minimum order subtotal
  maxUses     Int? // null = unlimited
  usedCount   Int        @default(0)
  maxDiscount Decimal?   @db.Decimal(10, 2) // cap for PERCENT type
  expiresAt   DateTime?
  isActive    Boolean    @default(true)
  orders      Order[]
  createdAt   DateTime   @default(now())

  @@index([code])
  @@index([isActive, expiresAt])
}

enum CouponType {
  FLAT
  PERCENT
  BIRTHDAY
}

// ─── Rewards ──────────────────────────────────────────────────────────────────

// Append-only ledger — never UPDATE or DELETE
model RewardPoint {
  id        String            @id @default(cuid())
  phoneHash String // SHA-256(+91XXXXXXXXXX)
  orderId   String? // null for manual grants/deductions
  change    Int // positive = earned, negative = redeemed/expired
  balance   Int // running total after this entry (denormalized)
  reason    RewardPointReason
  expiresAt DateTime? // earned points expire 12 months after earning
  createdAt DateTime          @default(now())

  @@index([phoneHash, createdAt])
  @@index([orderId])
  @@index([expiresAt])
}

enum RewardPointReason {
  ORDER_EARNED // +points on paid order
  ORDER_REDEEMED // -points used at checkout
  BIRTHDAY_BONUS // +points on birthday
  MANUAL_GRANT // admin grant
  MANUAL_DEDUCT // admin correction
  EXPIRED // -points on expiry
}

// ─── Wallet ───────────────────────────────────────────────────────────────────

// Append-only ledger — never UPDATE or DELETE. Rupee-denominated cashback wallet,
// separate from the points-based RewardPoint above. Keyed on SHA-256(phone), same
// identity model as CustomerAddress/RewardPoint — no customer accounts exist yet.
model WalletTransaction {
  id        String                  @id @default(cuid())
  phoneHash String // SHA-256 of normalized phone (+91XXXXXXXXXX)
  orderId   String? // order that earned/spent this — null for manual grants
  change    Decimal                 @db.Decimal(10, 2) // positive = credited, negative = redeemed/expired
  balance   Decimal                 @db.Decimal(10, 2) // running total after this entry (denormalized)
  reason    WalletTransactionReason
  note      String?
  createdAt DateTime                @default(now())

  @@index([phoneHash, createdAt])
  @@index([orderId])
}

enum WalletTransactionReason {
  CASHBACK_EARNED // +credited when an order's items with cashbackPercent are marked PAID
  REDEEMED // -spent against an order total at checkout
  REDEMPTION_REVERSED // +order cancelled/refunded after redemption — reverses the spend
  MANUAL_GRANT // admin grant
  MANUAL_DEDUCT // admin correction
}

// ─── Reviews ────────────────────────────────────────────────────────────────

model Review {
  id            String       @id @default(cuid())
  productId     String
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId       String // verified-purchase link — review must come from a real order
  customerName  String
  customerPhone String // used only to verify the order match, never displayed
  rating        Int // 1-5
  title         String?
  body          String       @db.Text
  status        ReviewStatus @default(PENDING)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([orderId, productId])
  @@index([productId, status])
  @@index([status, createdAt])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}
